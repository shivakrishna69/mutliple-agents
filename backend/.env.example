# Copy to .env and fill in real values. .env must never be committed.

# Runtime mode: "development" adds stack traces to error responses; "production" hides them.
NODE_ENV=development

# Port the Express HTTP server listens on.
PORT=5000

# MongoDB connection string, including the database name.
MONGO_URI=mongodb://127.0.0.1:27017/multiagent

# Secret used to sign and verify JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-64-byte-random-hex-string

# JWT lifetime, in a format accepted by jsonwebtoken (e.g. 15m, 1h, 7d).
JWT_EXPIRES_IN=1d

# Send auth cookies only over HTTPS. Defaults to true when NODE_ENV=production (where false is
# rejected at startup) and to false otherwise, so the http://localhost dev setup works.
COOKIE_SECURE=false

# Number of reverse proxies (load balancer, ingress) in front of the backend. Used to read the
# real client IP for rate limiting. Leave 0 when clients connect directly; a value higher than
# the real number of proxies lets clients spoof their IP via X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Comma-separated list of browser origins allowed by CORS (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# Origin of the FastAPI ai-service (scheme, host, port; any path is ignored).
AI_SERVICE_URL=http://localhost:8000

# How long the backend waits for the ai-service before falling back to a human handoff.
# Integer milliseconds, 1000–120000.
AI_SERVICE_TIMEOUT_MS=20000

# Shared secret the backend sends to the ai-service in the X-Internal-Api-Key header, so the
# ai-service can reject calls that did not come from this backend. At least 32 characters and
# different from every other secret here. Generate as for JWT_SECRET.
AI_SERVICE_API_KEY=change-me-to-a-different-64-byte-random-hex-string

# Shared secret used to verify X-Webhook-Signature on POST /api/webhooks/incoming
# (HMAC-SHA256 over "<X-Webhook-Timestamp>.<raw request body>"). Give the same value to the
# system that sends the webhooks. At least 32 characters and different from every other secret.
WEBHOOK_SIGNING_SECRET=change-me-to-another-64-byte-random-hex-string

# Optional. Email of the account that administers a fresh deployment: signing up with it creates an
# admin, and an existing account with it is promoted at startup. Admins then manage everyone else's
# roles from the Users page. Remove it once real administrators exist.
BOOTSTRAP_ADMIN_EMAIL=

# Optional. Redis connection for the Socket.IO adapter and the shared cache (org chart snapshot).
# Required when more than one backend instance runs, so real-time events reach clients connected
# to any instance and cache invalidations are seen by every instance. Use rediss:// for
# TLS and include credentials if needed: rediss://:password@host:6380. Leave empty for a single
# instance (in-memory rooms and cache). When set, startup fails if Redis is unreachable.
REDIS_URL=

# Minimum log level emitted: debug | info | warn | error
LOG_LEVEL=info

# --- Employee document vault (S3) -------------------------------------------------------------
# Optional. Leave VAULT_S3_BUCKET empty to disable the vault (its endpoints then answer 503).
# Credentials are NOT configured here: the AWS SDK reads them from the instance/task IAM role in
# production, or from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_PROFILE locally. Grant only
# s3:PutObject, s3:GetObject, s3:DeleteObject on arn:aws:s3:::<bucket>/vault/* (plus kms:Decrypt and
# kms:GenerateDataKey on a customer-managed key). Block all public access on the bucket.
VAULT_S3_BUCKET=
# Region of the bucket, e.g. ap-south-1. Required when VAULT_S3_BUCKET is set.
AWS_REGION=
# Server-side encryption: aws:kms (default) or AES256.
VAULT_S3_SSE=aws:kms
# Optional customer-managed KMS key (ARN or alias/...). Without it S3 uses the AWS-managed aws/s3 key.
VAULT_S3_KMS_KEY_ID=
# Optional, only for S3-compatible stores (MinIO, LocalStack). Must be https in production.
VAULT_S3_ENDPOINT=
# "true" for stores that require path-style URLs (most S3-compatible servers).
VAULT_S3_FORCE_PATH_STYLE=false

# --- Payslip PDFs (S3 + headless Chromium) ----------------------------------------------------
# Optional. Leave PAYSLIP_S3_BUCKET empty to disable payslip generation (its endpoints answer 503).
# Objects are written to company-payslips/YYYY/MM/ in this bucket (it may be the vault bucket).
# Same credential model and settings as the vault: AWS_REGION is shared; grant only
# s3:PutObject, s3:GetObject, s3:DeleteObject on arn:aws:s3:::<bucket>/company-payslips/*.
PAYSLIP_S3_BUCKET=
PAYSLIP_S3_SSE=aws:kms
PAYSLIP_S3_KMS_KEY_ID=
PAYSLIP_S3_ENDPOINT=
PAYSLIP_S3_FORCE_PATH_STYLE=false
# Required when PAYSLIP_S3_BUCKET is set: printed in every payslip header.
COMPANY_LEGAL_NAME=
COMPANY_REGISTERED_ADDRESS=
# Optional accent colour for payslips (#RRGGBB).
COMPANY_BRAND_COLOR=#4f46e5
# Required with PAYSLIP_S3_BUCKET: HMAC key for payslip verification IDs, at least 32 random
# characters, different from JWT_SECRET. Rotating it makes existing IDs fail verification.
PAYSLIP_SIGNING_SECRET=
# Optional public URL printed next to the verification ID (the verify endpoint, or a page using it).
PAYSLIP_VERIFICATION_BASE_URL=
# The Chromium build that renders PDFs (one is required with PAYSLIP_S3_BUCKET). Nothing is
# downloaded at install time: point at an installed browser, e.g. /usr/bin/chromium in a container,
# or name a channel: chrome | msedge | chromium.
PDF_BROWSER_EXECUTABLE_PATH=
PDF_BROWSER_CHANNEL=

# --- Employee invitations (email) -----------------------------------------------------------------
# Where people open the app; used in emailed invite links. Defaults to the first CORS origin.
# Must be https in production.
APP_PUBLIC_URL=http://localhost:5173
# Company name shown in invitation emails (defaults to COMPANY_LEGAL_NAME, then "Nova Support").
COMPANY_NAME=
# SMTP server for sending invitations. Leave SMTP_HOST empty to skip email: HR then gets a
# "copy invite link" to share manually. Works with Gmail (app password), Zoho, AWS SES, SendGrid…
SMTP_HOST=
SMTP_PORT=587
# "true" for implicit TLS (port 465); otherwise STARTTLS is required.
SMTP_SECURE=
# Keep empty (TLS required). "false" only for local mail catchers such as Mailpit; refused in production.
SMTP_REQUIRE_TLS=
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to the invitee, e.g. Nova HR <hr@yourcompany.com>
MAIL_FROM=
