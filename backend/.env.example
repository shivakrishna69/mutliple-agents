# Copy to .env and fill in real values. .env must never be committed.

# Runtime mode: "development" adds stack traces to error responses; "production" hides them.
NODE_ENV=development

# Port the Express HTTP server listens on.
PORT=5000

# MongoDB connection string, including the database name.
MONGO_URI=mongodb://127.0.0.1:27017/multiagent

# Secret used to sign and verify JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-64-byte-random-hex-string

# JWT lifetime, in a format accepted by jsonwebtoken (e.g. 15m, 1h, 7d).
JWT_EXPIRES_IN=1d

# Send auth cookies only over HTTPS. Defaults to true when NODE_ENV=production (where false is
# rejected at startup) and to false otherwise, so the http://localhost dev setup works.
COOKIE_SECURE=false

# Number of reverse proxies (load balancer, ingress) in front of the backend. Used to read the
# real client IP for rate limiting. Leave 0 when clients connect directly; a value higher than
# the real number of proxies lets clients spoof their IP via X-Forwarded-For.
TRUST_PROXY_HOPS=0

# Comma-separated list of browser origins allowed by CORS (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# Origin of the FastAPI ai-service (scheme, host, port; any path is ignored).
AI_SERVICE_URL=http://localhost:8000

# How long the backend waits for the ai-service before falling back to a human handoff.
# Integer milliseconds, 1000–120000.
AI_SERVICE_TIMEOUT_MS=20000

# Shared secret the backend sends to the ai-service in the X-Internal-Api-Key header, so the
# ai-service can reject calls that did not come from this backend. At least 32 characters and
# different from every other secret here. Generate as for JWT_SECRET.
AI_SERVICE_API_KEY=change-me-to-a-different-64-byte-random-hex-string

# Shared secret used to verify X-Webhook-Signature on POST /api/webhooks/incoming
# (HMAC-SHA256 over "<X-Webhook-Timestamp>.<raw request body>"). Give the same value to the
# system that sends the webhooks. At least 32 characters and different from every other secret.
WEBHOOK_SIGNING_SECRET=change-me-to-another-64-byte-random-hex-string

# Optional. Redis connection for the Socket.IO adapter, required when more than one backend
# instance runs, so real-time events reach clients connected to any instance. Use rediss:// for
# TLS and include credentials if needed: rediss://:password@host:6380. Leave empty for a single
# instance (in-memory rooms). When set, startup fails if Redis is unreachable.
REDIS_URL=

# Minimum log level emitted: debug | info | warn | error
LOG_LEVEL=info
