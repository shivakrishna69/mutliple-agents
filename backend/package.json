{
  "name": "multiagent-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express + Mongoose API tier: authentication, persistence, and gateway to the AI service.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
