# Copy to .env for local development. Real environment variables take precedence over this file.
# .env must never be committed.

# development | production. Production hides error details and disables /docs.
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Shared secret the backend sends in X-Internal-Api-Key. Must equal AI_SERVICE_API_KEY in
# backend/.env. At least 32 characters.
AI_SERVICE_API_KEY=change-me-to-the-same-value-as-the-backend

# Groq API key (https://console.groq.com/keys). Without it the service starts but /ai/process
# answers 503 and the backend escalates every conversation to a human.
GROQ_API_KEY=

# Groq model id. It must support tool calling (the router uses it for structured decisions).
# List the models your key can use: GET https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b

# Reasoning effort for reasoning models (gpt-oss, qwen3): low | medium | high. Set it empty
# (LLM_REASONING_EFFORT=) for models without reasoning, which reject the parameter.
LLM_REASONING_EFFORT=low

# Optional: alternative Groq-compatible endpoint (e.g. an egress proxy). Leave commented out to
# use Groq's default endpoint.
# GROQ_BASE_URL=https://api.groq.com

# Per-attempt LLM timeout, SDK retries for transient errors, sampling temperature for replies,
# and the reply length cap.
LLM_REQUEST_TIMEOUT_SECONDS=8
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=2048

# Hard deadline for a whole turn (routing + reply). Keep it below the backend's
# AI_SERVICE_TIMEOUT_MS (20000 by default) so the backend gets a clean 504 rather than timing out.
AI_PROCESS_TIMEOUT_SECONDS=18

# Let workers call the simulated tools (query_system_logs, check_invoice_status), which return
# invented but deterministic log and ledger data marked "data_source": "simulated".
# Defaults to true outside production; setting it true with APP_ENV=production is refused at startup.
SIMULATED_TOOLS_ENABLED=true

# How many recent transcript messages each model call sees.
MAX_CONTEXT_MESSAGES=30

# Conversation memory bounds for the in-process checkpointer.
THREAD_IDLE_TTL_SECONDS=7200
MAX_TRACKED_THREADS=1000
COMPACT_THREAD_AFTER_TURNS=10

# Optional. Groq model for the attendance regularization sub-agent; defaults to GROQ_MODEL. Any chat
# model that can return a JSON object works (output is validated with Pydantic). When it differs
# from GROQ_MODEL, LLM_REASONING_EFFORT is not sent to it (non-reasoning models reject it).
REGULARIZATION_GROQ_MODEL=

# Base URL of the backend's internal API (no trailing slash), used by the attendance regularization
# agent to write Attendance entries and file manager reviews. Authenticated with AI_SERVICE_API_KEY.
# Must be https in production. Leave empty to disable attendance regularization.
# From this container to a backend on the host machine: http://host.docker.internal:5000
BACKEND_INTERNAL_URL=

# Live agent telemetry (node and model timings, tool runs, retrieval scores; never message text),
# posted to the backend, which relays it to admin telemetry consoles over Socket.IO.
# Defaults to on when BACKEND_INTERNAL_URL is set; "false" turns it off.
AGENT_TELEMETRY_ENABLED=

# --- Department knowledge index (app/knowledge/) ----------------------------------------------
# Qdrant, where department documents' chunks are stored for the department agents. Leave empty to
# turn the index off: its endpoints then answer 503 and the backend keeps documents waiting.
# In the compose files both are set for you (QDRANT_API_KEY comes from the stack settings).
# Run one locally: docker run -p 6333:6333 -e QDRANT__SERVICE__API_KEY=<key> qdrant/qdrant:v1.20.0
QDRANT_URL=
# Required with QDRANT_URL: the same key Qdrant was started with, at least 32 characters.
QDRANT_API_KEY=
# Seconds to wait for Qdrant before a request counts as failed (1-60, default 10).
QDRANT_TIMEOUT_SECONDS=10
# Where the embedding model (BAAI/bge-small-en-v1.5, about 65 MB) is kept. Empty uses fastembed's
# default folder; it is downloaded there the first time it is needed.
EMBEDDING_CACHE_DIR=
# "true" never downloads the model (it must already be in EMBEDDING_CACHE_DIR). Required in
# production; the production image carries the model and sets this itself.
EMBEDDING_OFFLINE=

# --- Answers from department knowledge (POST /ai/knowledge/answer) ---
# Passages the search returns for a question (1-20, default 5).
KNOWLEDGE_ANSWER_TOP_K=5
# Least relevance (cosine similarity 0-1, default 0.5) a passage needs to reach the model. When no
# passage reaches it the agent answers "not found" without calling the model; above it, the model
# itself replies NOT_FOUND when no passage is relevant. Measured with bge-small-en-v1.5: questions a
# document answers scored 0.64-0.89 (paraphrases at the low end), unrelated ones at most 0.45, and
# questions near a document's topic that it does not answer up to about 0.55, which the model handles.
KNOWLEDGE_MIN_RELEVANCE=0.5
# Earlier messages of the conversation sent with a question (0-20, default 6).
KNOWLEDGE_ANSWER_HISTORY_MESSAGES=6
# Longest excerpt of a cited passage returned with an answer, in characters (100-2000, default 1200;
# chunks are at most 1,800 characters; a longer passage is cut at a word and ends with …).
KNOWLEDGE_EXCERPT_CHARS=1200
# Model temperature for these answers (0-1, default 0.1): low, so answers keep to the documents.
KNOWLEDGE_ANSWER_TEMPERATURE=0.1
