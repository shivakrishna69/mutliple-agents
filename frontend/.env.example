# Copy to .env.local to override. Variables prefixed VITE_ are embedded in the browser bundle,
# so never put secrets here.

# Backend origin the Vite dev server proxies /api requests to (development only).
VITE_BACKEND_PROXY_TARGET=http://localhost:5000

# Absolute API origin for builds served separately from the backend, e.g. https://api.example.com.
# Leave empty to call the API on the same origin as the frontend (/api/...).
VITE_API_BASE_URL=
